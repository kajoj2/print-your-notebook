    "@myriaddreamin/typst.ts": "0.8.0-rc3",
    "lucide-react": "^1.59.0",
    "motion": "^13.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
